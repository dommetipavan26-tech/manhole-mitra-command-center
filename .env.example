# Render assigns PORT automatically. Keep 3000 for local development.
PORT=3000

# Set long random values. Never commit actual values to GitHub.
# ESP32 firmware WEBSITE_PUSH_SECRET must be identical to this value.
WEBHOOK_SECRET=replace-with-a-long-random-webhook-secret
CONTROL_KEY=replace-with-a-separate-control-key

# Blynk server shown in your Blynk Console region. BLR1 usually uses this URL.
BLYNK_SERVER=https://blr1.blynk.cloud

# Required only for the website's secure V10 reset button and polling fallback.
# Keep server-side only. Never put this token in frontend JavaScript.
BLYNK_DEVICE_TOKEN=

# Poll Blynk every 1 second so the dashboard tracks the physical node closely.
# Webhooks are still faster if your Blynk plan supports them.
POLL_BLYNK=true
POLL_INTERVAL_MS=1000

# Set true only for a visual preview before live Blynk data arrives.
DEMO_MODE=false
